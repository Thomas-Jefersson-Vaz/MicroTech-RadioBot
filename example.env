# Copy to .env locally, or enter these variables in Portainer.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Set for immediate registration in a test guild; blank registers globally.
GUILD_ID=
SESSION_SECRET=
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=mikrotech_v3
POSTGRES_PORT=5432
REDIS_PORT=6379
NODELINK_PORT=2333
NODELINK_PASSWORD=
# Candidate digest: server playback validation is still required before production release.
NODELINK_BASE_IMAGE=performanc/nodelink@sha256:e15a9ae334f36432ed7f544521644bc99820eaba77ac4e592d939169b7a0bfa8
NODELINK_WORKERS=1
NODELINK_MAX_PLAYLIST_LENGTH=10000
NODELINK_LOG_LEVEL=info
NODELINK_HTTP_ENABLED=false
NODELINK_RESAMPLING_QUALITY=best
API_PORT=3000
FRONTEND_PORT=3001
FRONTEND_URL=http://localhost:3001
CALLBACK_URL=http://localhost:3001/auth/discord/callback
# HTTPS deployment: true; backend trusts one gateway proxy hop.
COOKIE_SECURE=false
TRUST_PROXY=1
NODE_ENV=development
BUILD_REVISION=local
LOG_LEVEL=INFO
# AI is disabled unless a key AND explicit model are configured.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
